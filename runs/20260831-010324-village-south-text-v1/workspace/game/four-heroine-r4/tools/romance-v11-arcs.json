      "choices": {
        "independent": {
          "label": "咱们自己录一版，写你的名字",
          "risk": "这波热度可能就没了",
          "response": {
            "voice": "唐映雪",
            "text": "好。你帮我找个棚，我想亲自唱一版给他们听。",
            "shot": "singerBond"
          },
          "afterBeat": {
            "voice": "唐映雪",
            "text": "我现在就去约录音棚。今晚我还不想睡。"
          }
