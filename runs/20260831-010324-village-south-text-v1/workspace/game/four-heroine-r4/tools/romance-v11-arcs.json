          "afterBeat": {
            "voice": "许照 · 心声",
            "text": "她盯着那条视频，按下了“取消发布”。"
          }
        },
        "unchanged": {
          "label": "这事你定。我不替你做主",
          "risk": "她得自己面对那群人",
          "response": {
            "voice": "唐映雪",
            "text": "行，那我自己去。不是生你的气，就是想亲口说。",
            "shot": "singerBond"
          }
        }
      },
      "intentLabels": {
        "credit": "我陪你把歌的名字争回来",
        "space": "先停一停，听她自己的打算"
      },
      "secondStage": "好，你说说，接下来这首歌怎么发才不吃亏？"
    },
    "A2b": {
