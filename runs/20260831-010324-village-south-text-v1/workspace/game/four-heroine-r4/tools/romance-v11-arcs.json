          }
        },
        "duet": {
          "label": "合唱也行，先把作者写对",
          "risk": "陆景行可能更抢眼",
          "response": {
            "voice": "唐映雪",
            "text": "我不怕合唱。怕的是唱完连名字都没了。",
            "shot": "singerBond"
          }
        },
        "pause": {
          "label": "那就先撤。歌不能这么发",
          "risk": "今晚的流量留不住",
          "response": {
            "voice": "唐映雪",
            "text": "撤吧。我写了这么久，不差这一晚上。",
            "shot": "singerBond"
