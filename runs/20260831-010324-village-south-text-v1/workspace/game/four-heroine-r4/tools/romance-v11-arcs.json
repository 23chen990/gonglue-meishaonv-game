{
  "version": 1,
  "arcs": {
    "A1b": {
      "shot": "console",
      "intro": [
        {
          "voice": "程放",
          "text": "错版伴奏的责任单，只留了你一个签名栏。许照，签了就下班。"
        },
        {
          "voice": "许照 · 心声",
          "text": "伴奏不是我导出的，为什么整场事故都算我头上？"
        },
        {
          "voice": "程放",
          "text": "大家都等着。今天不签，我明天就说你不配合。"
        }
      ],
      "choices": {
        "check": {
          "label": "我碰过哪台，就只签哪台",
          "risk": "他可能当场翻脸",
          "response": {
            "voice": "阿衡",
            "text": "这台一直是我守着的。错版真不是他放的。",
            "shot": "crew"
          },
          "afterBeat": {
            "voice": "许照 · 心声",
            "text": "我把那行字划了。程放把笔攥得咔一声响。"
          }
        },
        "ask": {
          "label": "阿衡，你刚才也在，帮我说句话",
          "risk": "阿衡也会被叫去问话",
          "response": {
            "voice": "阿衡",
            "text": "我能作证他没动控台。别的，你别逼我乱说。",
            "shot": "crew"
          }
        },
        "look": {
          "label": "这表我先拍张照，明天再谈",
          "risk": "主管可能扣着你不放",
          "response": {
            "voice": "程放",
            "text": "你还挺谨慎。行，明天带着照片来找我。",
            "shot": "console"
          },
          "afterBeat": {
            "voice": "许照 · 心声",
            "text": "我拍完照，才把那张表推回去。"
          }
        }
      }
    },
    "A2a": {
      "shot": "singer",
      "intro": [
        {
          "voice": "唐映雪",
          "text": "你看热搜。标题只写陆景行——昨晚弹钢琴的那个。"
