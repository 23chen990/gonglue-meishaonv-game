  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite runs/20260831-010324-village-south-text-v1/workspace/game --config runs/20260831-010324-village-south-text-v1/workspace/game/vite.config.ts --host 127.0.0.1",
    "build": "pnpm --dir runs/20260831-010324-village-south-text-v1/workspace/game build",
    "lint": "eslint --no-ignore --ignore-pattern '!runs/**' src runs/20260831-010324-village-south-text-v1/workspace/game/src runs/20260831-010324-village-south-text-v1/workspace/game/tests runs/20260831-010324-village-south-text-v1/workspace/game/vite.config.ts runs/20260831-010324-village-south-text-v1/planning/2026-10-01-life-redesign/*.ts tools/*.ts",
    "typecheck": "tsc --noEmit -p runs/20260831-010324-village-south-text-v1/workspace/game/tsconfig.json && tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --skipLibCheck runs/20260831-010324-village-south-text-v1/planning/2026-10-01-life-redesign/story-schema.ts runs/20260831-010324-village-south-text-v1/planning/2026-10-01-life-redesign/story-validation.ts runs/20260831-010324-village-south-text-v1/planning/2026-10-01-life-redesign/story-validation.test.ts tools/validate-story.ts",
    "test:game": "vitest run --root runs/20260831-010324-village-south-text-v1/workspace/game",
    "test:story": "vitest run --root runs/20260831-010324-village-south-text-v1/planning/2026-10-01-life-redesign story-validation.test.ts",
    "test": "pnpm test:game && pnpm test:story",
    "story:validate": "tsx tools/validate-story.ts",
    "test:legacy-mobile": "tsx runs/20260831-010324-village-south-text-v1/workspace/game/tests/mobile-playwright.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm story:validate"
  },
  "dependencies": { "yaml": "2.9.0", "zod": "4.4.3" },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
